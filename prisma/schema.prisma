generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Stage {
  Eval
  Funded
}

enum AccountStatus {
  Running
  Passed
  Breached
}

/** Prop / SIM / cleared account; starting capital lives only on this row. */
model Account {
  id              Int      @id @default(autoincrement())
  name            String
  /** Prop firm this account belongs to (e.g. Lucid, Apex). */
  propfirmName    String?
  /** Free-form notes about the account. */
  description     String?
  /** Lifecycle status: Running (active), Passed (eval cleared / payout stage), or Breached / blown. */
  status          AccountStatus @default(Running)
  /** How many live accounts this row represents (copy trading). */
  numberOfAccounts Int     @default(1)
  /** Eval vs Funded phase. */
  stage           Stage    @default(Eval)
  /** Purchase / eval cost paid for this account (USD). */
  cost            Float    @default(0)
  /** Total payouts received from this account (USD). */
  payout          Float    @default(0)
  /** Exclude this account from cross-account calculations (still switchable individually). */
  hiddenFromStats Boolean  @default(false)
  /** Starting account size for equity curve, capital chain, and CSV import (single source per account). */
  initialBalance  Float    @default(50000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trades Trade[]
  fills  Fill[]

  @@map("Account")
}

model Fill {
  id           String   @id
  accountId    Int
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contractId   Int
  contractName String
  action       String
  qty          Int
  price        Float
  fees         Float
  timestamp    DateTime
  orderId      String
  tradeDate    String
  syncedAt     DateTime @default(now())

  @@index([accountId, timestamp])
}

model Trade {
  id            String   @id @default(cuid())
  accountId     Int
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contractId    Int
  contractName  String
  direction     String
  qty           Int
  entryFillId   String
  exitFillId    String
  entryPrice    Float
  exitPrice     Float
  entryTime     DateTime
  exitTime      DateTime
  holdingMins   Float
  grossPnl      Float
  fees          Float
  netPnl        Float
  rMultiple     Float?
  qualityScore  Int?
  entryScore    Int?
  exitScore     Int?
  riskScore     Int?
  scoreNotes    String?
  capitalBefore Float
  capitalAfter  Float
  createdAt     DateTime @default(now())

  @@index([accountId, entryTime])
}
